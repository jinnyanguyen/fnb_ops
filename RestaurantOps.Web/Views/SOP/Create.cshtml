@model RestaurantOps.Models.SOPTemplate

@{
    ViewData["Title"] = "Create SOP Template";
}

<h2 class="mb-4">Create SOP Template</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="4">
        </textarea>

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-success">
        Save SOP Template
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}