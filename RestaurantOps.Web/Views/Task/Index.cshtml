@model IEnumerable<RestaurantOps.Models.TaskAssignment>

<h2>All Tasks</h2>

<a href="/Task/Create" class="btn btn-primary">Create Task</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Title</th>
            <th>User</th>
            <th>Status</th>
            <th>Due Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.User?.Email</td>
                <td>
                    @if (task.IsOverdue)
                    {
                        <span class="badge bg-danger">
                            Overdue
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            @task.Status
                        </span>
                    }
                    @if (task.CompletedAt != null)
                    {
                        <small class="text-muted">
                            Completed:
                            @task.CompletedAt.Value.ToString("g")
                        </small>
                    }
                </td>
                <td>@task.DueDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>