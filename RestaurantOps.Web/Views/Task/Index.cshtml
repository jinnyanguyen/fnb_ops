@model IEnumerable<RestaurantOps.Models.TaskAssignment>

<h2>All Tasks</h2>

<a href="/Task/Create" class="btn btn-primary">Create Task</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Title</th>
            <th>User</th>
            <th>Status</th>
            <th>Due Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.User?.Email</td>
                <td>@task.Status</td>
                <td>@task.DueDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>