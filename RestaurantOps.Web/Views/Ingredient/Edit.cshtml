@model RestaurantOps.Models.Ingredient

<h2>Edit Ingredient</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="IngredientId" />
    <input type="hidden" asp-for="BranchId" />

    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Unit</label>
        <input asp-for="Unit" class="form-control" />
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input asp-for="QuantityOnHand" class="form-control" />
    </div>

    <div class="form-group">
        <label>Cost Per Unit</label>
        <input asp-for="CostPerUnit" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-success">Update</button>
    <a href="/Ingredient" class="btn btn-secondary">Cancel</a>

</form>