@model RestaurantOps.Web.ViewModels.InventoryAdjustmentViewModel

<h2>
    Adjust Inventory Stock
</h2>

<hr />

<div class="card p-4">

    <h4>
        @Model.IngredientName
    </h4>

    <form asp-action="AdjustStock"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="IngredientId"
               type="hidden" />

        <div class="form-group">

            <label>
                Quantity To Add
            </label>

            <input asp-for="QuantityToAdd"
                   class="form-control"
                   step="0.01" />

        </div>

        <div class="form-group mt-3">

            <label>
                Reason
            </label>

            <input asp-for="Reason"
                   class="form-control" />

        </div>

        <br />

        <button type="submit"
                class="btn btn-success">

            Save Adjustment

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>