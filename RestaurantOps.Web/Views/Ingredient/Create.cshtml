@model RestaurantOps.Models.Ingredient

<h2>Add Ingredient</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Unit</label>
        <input asp-for="Unit" class="form-control" />
        <span asp-validation-for="Unit" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input asp-for="QuantityOnHand" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="QuantityOnHand" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Cost Per Unit</label>
        <input asp-for="CostPerUnit" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="CostPerUnit" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/Ingredient" class="btn btn-secondary">Cancel</a>

</form>