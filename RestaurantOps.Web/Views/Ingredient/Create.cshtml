@model RestaurantOps.Models.Ingredient

<h2>Add Ingredient</h2>

<hr />

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <!-- Ingredient Name -->
    <div class="form-group mb-3">

        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control"
               placeholder="Enter ingredient name" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>

    <!-- Measurement Unit -->
    <div class="form-group mb-3">

        <label asp-for="Unit"
               class="form-label">
        </label>

        <input asp-for="Unit"
               class="form-control"
               placeholder="Example: g, kg, ml, pcs" />

        <span asp-validation-for="Unit"
              class="text-danger">
        </span>

    </div>

    <!-- Quantity On Hand -->
    <div class="form-group mb-3">

        <label asp-for="QuantityOnHand"
               class="form-label">
        </label>

        <input asp-for="QuantityOnHand"
               type="number"
               step="0.01"
               min="0"
               class="form-control" />

        <span asp-validation-for="QuantityOnHand"
              class="text-danger">
        </span>

    </div>

    <!-- Cost Per Unit -->
    <div class="form-group mb-3">

        <label asp-for="CostPerUnit"
               class="form-label">
        </label>

        <input asp-for="CostPerUnit"
               type="number"
               step="0.01"
               min="0"
               class="form-control" />

        <span asp-validation-for="CostPerUnit"
              class="text-danger">
        </span>

    </div>

    <!-- Reorder Level -->
    <div class="form-group mb-3">

        <label asp-for="ReorderLevel"
               class="form-label">

            Reorder Level

        </label>

        <input asp-for="ReorderLevel"
               type="number"
               step="0.01"
               min="0"
               class="form-control"
               placeholder="Minimum stock before alert" />

        <small class="text-muted">

            Low stock alerts will appear when
            Quantity On Hand falls below this level.

        </small>

        <span asp-validation-for="ReorderLevel"
              class="text-danger">
        </span>

    </div>

    <br />

    <!-- Buttons -->
    <button type="submit"
            class="btn btn-success">

        Save Ingredient

    </button>

    <a asp-controller="Ingredient"
       asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}