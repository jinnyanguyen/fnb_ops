@model IEnumerable<RestaurantOps.Models.Recipe>

<div class="container mt-4">

    <h2>Recipes</h2>

    <a href="/Recipe/Create" class="btn btn-primary">Create Recipe</a>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.RecipeId" class="btn btn-info btn-sm">View</a>

                        <a asp-action="Edit" asp-route-id="@item.RecipeId" class="btn btn-warning btn-sm">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>