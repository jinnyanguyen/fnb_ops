@model IEnumerable<RestaurantOps.Models.Recipe>

<h2>Recipes</h2>

<a href="/Recipe/Create" class="btn btn-primary">Create Recipe</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a href="/Recipe/Details/@item.RecipeId" class="btn btn-info btn-sm">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>