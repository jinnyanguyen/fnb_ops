@model RestaurantOps.Models.Recipe

<h2>@Model.Name</h2>

<hr />

<h4>Recipe Information</h4>

<p><strong>Category:</strong> @Model.Category</p>

<p>
    <strong>Selling Price:</strong>
    $@Model.SellingPrice.ToString("0.00")
</p>

@if (!string.IsNullOrWhiteSpace(Model.Instructions))
{
    <p><strong>Instructions:</strong> @Model.Instructions</p>
}

@if (Model.PrepTimeMinutes > 0)
{
    <p><strong>Preparation Time:</strong> @Model.PrepTimeMinutes minutes</p>
}

<hr />

<h4>Financial Summary</h4>

<div class="card p-3 mb-3">
    <p>
        <strong>Total Cost:</strong>
        $@string.Format("{0:F2}", ViewBag.Cost)
    </p>

    <p>
        <strong>Profit:</strong>
        $@string.Format("{0:F2}", ViewBag.Profit ?? 0)
    </p>

    <p>
        <strong>Profit Margin:</strong>
        @string.Format("{0:F2}", ViewBag.Margin ?? 0) %
    </p>
</div>

<hr />

<h4>Add Ingredient</h4>

<form asp-action="AddIngredient"
      asp-controller="Recipe"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="recipeId"
           value="@Model.RecipeId" />

    <div class="form-group">
        <label>Ingredient</label>

        <select name="ingredientId"
                class="form-control">

            @foreach (var item in ViewBag.Ingredients)
            {
                <option value="@item.IngredientId">
                    @item.Name
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Quantity Required</label>

        <input type="number"
               step="0.01"
               name="quantity"
               class="form-control"
               required />
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Add Ingredient
    </button>
</form>

<hr />

<h4>Ingredients in Recipe</h4>

<table class="table table-bordered table-striped mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Quantity Required</th>
            <th>Cost Per Unit</th>
            <th>Total Cost</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
    @if (Model.RecipeIngredients != null && Model.RecipeIngredients.Any())
    {
        @foreach (var item in Model.RecipeIngredients)
        {
            var costPerUnit = item.Ingredient?.CostPerUnit ?? 0;
            var lineTotal = item.QuantityRequired * costPerUnit;

            <tr>
                <td>@item.Ingredient?.Name</td>

                <td>
                    @item.QuantityRequired.ToString("0.##")
                </td>

                <td>
                    $@costPerUnit.ToString("0.00")
                </td>

                <td>
                    $@lineTotal.ToString("0.00")
                </td>

                <td>
                    <form asp-action="RemoveIngredient"
                          asp-controller="Recipe"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="recipeId"
                               value="@Model.RecipeId" />

                        <input type="hidden"
                               name="ingredientId"
                               value="@item.IngredientId" />

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Remove
                        </button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="5"
                class="text-center text-muted">
                No ingredients added yet.
            </td>
        </tr>
    }
    </tbody>
</table>

<hr />

<h4>Preparation Steps</h4>

<form asp-action="AddStep"
      asp-controller="Recipe"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="RecipeId"
           value="@Model.RecipeId" />

    <div class="form-group">
        <label>Step Instruction</label>

        <input name="Instruction"
               class="form-control"
               required />
    </div>

    <div class="form-group mt-2">
        <label>Step Order</label>

        <input name="StepOrder"
               type="number"
               class="form-control"
               value="1"
               min="1"
               required />
    </div>

    <br />

    <button type="submit"
            class="btn btn-success">
        Add Preparation Step
    </button>
</form>

<br />

@if (Model.RecipeSteps != null && Model.RecipeSteps.Any())
{
    <ol class="list-group list-group-numbered">
        @foreach (var step in Model.RecipeSteps.OrderBy(s => s.StepOrder))
        {
            <li class="list-group-item">
                <strong>Step @step.StepOrder:</strong>
                @step.Instruction
            </li>
        }
    </ol>
}
else
{
    <div class="alert alert-warning mt-3">
        No preparation steps added yet.
    </div>
}

<br />

<a asp-controller="Recipe"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Recipes
</a>