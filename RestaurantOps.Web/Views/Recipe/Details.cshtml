@model RestaurantOps.Models.Recipe

<h2>@Model.Name</h2>

<h4>Total Cost:
    <span class="text-success">
        @(ViewBag.Cost != null ? ((decimal)ViewBag.Cost).ToString("C") : "$0.00")
    </span>
</h4>

<hr />

<h4>Add Ingredient</h4>

<form asp-action="AddIngredient" method="post">
    <input type="hidden" name="recipeId" value="@Model.RecipeId" />

    <div class="form-group mb-2">
        <label>Ingredient</label>
        <select name="ingredientId" class="form-control">
            @foreach (var ing in ViewBag.Ingredients)
            {
                <option value="@ing.IngredientId">@ing.Name</option>
            }
        </select>
    </div>

    <div class="form-group mb-2">
        <label>Quantity</label>
        <input type="number" step="0.01" name="quantity" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
</form>

<hr />

<h4>Ingredients in Recipe</h4>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Quantity</th>
            <th>Cost</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.RecipeIngredients)
        {
            <tr>
                <td>@item.Ingredient?.Name</td>
                <td>@item.Quantity</td>
                <td>@(item.Quantity * item.Ingredient?.CostPerUnit)</td>
            </tr>
        }
    </tbody>
</table>