@model RestaurantOps.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">
    Dashboard
</h2>
<div class="mb-4">

    <a asp-action="ExportInventory"
       class="btn btn-success">

        Export Inventory

    </a>

    <a asp-action="ExportSales"
       class="btn btn-primary">

        Export Sales

    </a>

    <a asp-action="ExportStaffPerformance"
       class="btn btn-dark">

        Export Staff Performance

    </a>

</div>

<!-- ========================================= -->
<!-- KPI SUMMARY CARDS -->
<!-- ========================================= -->

<div class="row mb-4">

    <!-- Total Recipes -->
    <div class="col-md-3 mb-3">

        <div class="card text-white bg-primary shadow-sm h-100">

            <div class="card-body">

                <h5 class="card-title">
                    Total Recipes
                </h5>

                <h2>
                    @Model.TotalRecipes
                </h2>

            </div>

        </div>

    </div>

    <!-- Total Ingredients -->
    <div class="col-md-3 mb-3">

        <div class="card text-white bg-success shadow-sm h-100">

            <div class="card-body">

                <h5 class="card-title">
                    Total Ingredients
                </h5>

                <h2>
                    @Model.TotalIngredients
                </h2>

            </div>

        </div>

    </div>

    <!-- Total Sales -->
    <div class="col-md-3 mb-3">

        <div class="card text-white bg-warning shadow-sm h-100">

            <div class="card-body">

                <h5 class="card-title">
                    Total Sales
                </h5>

                <h2>
                    $@Model.TotalSales.ToString("0.00")
                </h2>

            </div>

        </div>

    </div>

    <!-- Low Stock Alerts -->
    <div class="col-md-3 mb-3">

        <div class="card text-white bg-danger shadow-sm h-100">

            <div class="card-body">

                <h5 class="card-title">
                    Low Stock Alerts
                </h5>

                <h2>
                    @Model.LowStockCount
                </h2>

            </div>

        </div>

    </div>

</div>

<!-- ========================================= -->
<!-- SECONDARY KPI ROW -->
<!-- ========================================= -->

<div class="row mb-4">

    <!-- Inventory Value -->
    <div class="col-md-6 mb-3">

        <div class="card border-primary shadow-sm">

            <div class="card-body">

                <h5 class="card-title">
                    Total Inventory Value
                </h5>

                <h3 class="text-primary">

                    $@Model.TotalInventoryValue.ToString("0.00")

                </h3>

            </div>

        </div>

    </div>

    <!-- Open Tasks -->
    <div class="col-md-6 mb-3">

        <div class="card border-warning shadow-sm">

            <div class="card-body">

                <h5 class="card-title">
                    Open Tasks
                </h5>

                <h3 class="text-warning">

                    @Model.OpenTasks

                </h3>

            </div>

        </div>

    </div>

</div>

<hr />

<!-- ========================================= -->
<!-- OPERATIONS ANALYTICS -->
<!-- ========================================= -->

<div class="row mb-4">

    <!-- TASK COMPLETION -->

    <div class="col-md-4 mb-3">

        <div class="card border-success shadow-sm">

            <div class="card-body">

                <h5>
                    Task Completion
                </h5>

                <h2 class="text-success">

                    @Model.TaskCompletionRate.ToString("0.0")%

                </h2>

            </div>

        </div>

    </div>

    <!-- SOP COMPLIANCE -->

    <div class="col-md-4 mb-3">

        <div class="card border-primary shadow-sm">

            <div class="card-body">

                <h5>
                    SOP Compliance
                </h5>

                <h2 class="text-primary">

                    @Model.SOPComplianceRate.ToString("0.0")%

                </h2>

            </div>

        </div>

    </div>

    <!-- ACTIVE KITCHEN -->

    <div class="col-md-4 mb-3">

        <div class="card border-warning shadow-sm">

            <div class="card-body">

                <h5>
                    Active Kitchen Sessions
                </h5>

                <h2 class="text-warning">

                    @Model.ActiveKitchenSessions

                </h2>

            </div>

        </div>

    </div>

</div>

<!-- ========================================= -->
<!-- LOW STOCK ALERTS -->
<!-- ========================================= -->

<h3 class="mb-3">
    Low Stock Alerts
</h3>

@if (!Model.LowStockIngredients.Any())
{
    <div class="alert alert-success">

        All inventory levels are healthy.

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead class="table-danger">

                <tr>
                    <th>Ingredient</th>
                    <th>Quantity On Hand</th>
                    <th>Reorder Level</th>
                    <th>Unit</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var ingredient in Model.LowStockIngredients)
                {
                    <tr>

                        <td>
                            @ingredient.Name
                        </td>

                        <td>
                            @ingredient.QuantityOnHand
                        </td>

                        <td>
                            @ingredient.ReorderLevel
                        </td>

                        <td>
                            @ingredient.Unit
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

<hr />

<!-- ========================================= -->
<!-- SALES TREND -->
<!-- ========================================= -->

<h3 class="mb-3">
    Sales Trend
</h3>

@if (!Model.SalesDates.Any()
 || !Model.SalesTotals.Any())
{
    <div class="alert alert-warning">

        No sales data available.

    </div>
}

<div style="height:400px">

    <canvas id="salesChart"></canvas>

</div>

<hr />

<!-- ========================================= -->
<!-- STAFF PERFORMANCE ANALYTICS -->
<!-- ========================================= -->

<h3 class="mb-3">
    Staff Performance Analytics
</h3>

@if (!Model.StaffPerformance.Any())
{
    <div class="alert alert-info">

        No staff performance data available.

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered table-hover">

            <thead class="table-dark">

                <tr>

                    <th>Staff Member</th>

                    <th>SOPs Completed</th>

                    <th>Recipes Completed</th>

                    <th>Tasks Completed</th>

                    <th>Overdue Tasks</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var staff in Model.StaffPerformance)
                {
                    <tr>

                        <td>
                            @staff.StaffName
                        </td>

                        <td>
                            @staff.SOPCompletedCount
                        </td>

                        <td>
                            @staff.RecipeExecutionCount
                        </td>

                        <td>
                            @staff.TaskCompletedCount
                        </td>

                        <td>

                            @if (staff.OverdueTaskCount > 0)
                            {
                                <span class="badge bg-danger">

                                    @staff.OverdueTaskCount

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">

                                    0

                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

<!-- ========================================= -->
<!-- ADVANCED BUSINESS ANALYTICS -->
<!-- ========================================= -->

<h3 class="mb-3">
    Business Analytics
</h3>

<div class="row">

    <!-- TOP SELLING RECIPES -->

    <div class="col-md-6">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">
                    Top Selling Recipes
                </h5>

            </div>

            <div class="card-body">

                @if (Model.TopSellingRecipes == null ||
                    !Model.TopSellingRecipes.Any())
                {
                    <div class="alert alert-warning">

                        No sales analytics available.

                    </div>
                }
                else
                {
                    <table class="table table-striped">

                        <thead>

                            <tr>

                                <th>
                                    Recipe
                                </th>

                                <th>
                                    Quantity Sold
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var recipe in Model.TopSellingRecipes)
                            {
                                <tr>

                                    <td>
                                        @recipe.RecipeName
                                    </td>

                                    <td>
                                        @recipe.QuantitySold
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }

            </div>

        </div>

    </div>

    <!-- MOST USED INGREDIENTS -->

    <div class="col-md-6">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">
                    Most Used Ingredients
                </h5>

            </div>

            <div class="card-body">

                @if (!Model.MostUsedIngredients.Any())
                {
                    <div class="alert alert-warning">

                        No inventory analytics available.

                    </div>
                }
                else
                {
                    <table class="table table-striped">

                        <thead>

                            <tr>

                                <th>
                                    Ingredient
                                </th>

                                <th>
                                    Quantity Used
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var ingredient in Model.MostUsedIngredients)
                            {
                                <tr>

                                    <td>
                                        @ingredient.IngredientName
                                    </td>

                                    <td>
                                        @ingredient.QuantityUsed.ToString("0.00")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }

            </div>

        </div>

    </div>

</div>
<!-- ========================================= -->
<!-- CHART.JS -->
<!-- ========================================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    // =========================================
    // SALES CHART DATA
    // =========================================

    const labels =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.SalesDates
            )
        );

    const data =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.SalesTotals
            )
        );

    // =========================================
    // CHART INITIALIZATION
    // =========================================

    const ctx =
        document
            .getElementById('salesChart')
            .getContext('2d');

    new Chart(ctx, {

        type: 'line',

        data: {

            labels: labels,

            datasets: [{

                label: 'Sales Revenue ($)',

                data: data,

                borderColor: 'blue',

                backgroundColor:
                    'rgba(0, 123, 255, 0.2)',

                borderWidth: 2,

                fill: true,

                tension: 0.3,

                pointRadius: 5,

                pointBackgroundColor: 'red'

            }]
        },

        options: {

            responsive: true,

            plugins: {

                legend: {
                    display: true
                }

            },

            scales: {

                x: {

                    title: {

                        display: true,

                        text: 'Date'

                    }

                },

                y: {

                    title: {

                        display: true,

                        text: 'Sales Revenue ($)'

                    },

                    beginAtZero: true

                }

            }

        }

    });

</script>