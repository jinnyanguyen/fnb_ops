@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<!-- ========================= -->
<!-- SUMMARY CARDS -->
<!-- ========================= -->
<div class="row mb-4">

    <div class="col-md-3">
        <div class="card text-white bg-primary p-3">
            <h5>Total Recipes</h5>
            <h2>@ViewBag.TotalRecipes</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success p-3">
            <h5>Total Ingredients</h5>
            <h2>@ViewBag.TotalIngredients</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-warning p-3">
            <h5>Total Sales</h5>
            <h2>$@ViewBag.TotalSales</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger p-3">
            <h5>Low Stock Items</h5>
            <h2>@ViewBag.LowStockCount</h2>
        </div>
    </div>

</div>

<!-- ========================= -->
<!-- LOW STOCK ALERTS -->
<!-- ========================= -->
<h3>Low Stock Alerts</h3>

@if (ViewBag.LowStockIngredients == null || ViewBag.LowStockIngredients.Count == 0)
{
    <div class="alert alert-success">
        All ingredients are currently above reorder level.
    </div>
}
else
{
    <div class="alert alert-danger">
        The following ingredients are at or below reorder level.
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Ingredient</th>
                <th>Quantity On Hand</th>
                <th>Reorder Level</th>
                <th>Unit</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var ingredient in ViewBag.LowStockIngredients)
        {
            <tr>
                <td>@ingredient.Name</td>
                <td>@ingredient.QuantityOnHand.ToString("0.##")</td>
                <td>@ingredient.ReorderLevel.ToString("0.##")</td>
                <td>@ingredient.Unit</td>
            </tr>
        }
        </tbody>
    </table>
}

<hr />

<!-- ========================= -->
<!-- SALES TREND -->
<!-- ========================= -->
<h3>Sales Trend</h3>

@if (ViewBag.SalesDates == null || ViewBag.SalesTotals == null)
{
    <p style="color:red;">⚠️ No sales data available</p>
}

<canvas id="salesChart" height="100"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var labels = [];
    var data = [];

    @if (ViewBag.SalesDates != null && ViewBag.SalesTotals != null)
    {
        <text>
            labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((List<string>)ViewBag.SalesDates));
            data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((List<decimal>)ViewBag.SalesTotals));
        </text>
    }

    var ctx = document.getElementById('salesChart').getContext('2d');

    var salesChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Sales ($)',
                data: data,
                borderColor: 'blue',
                backgroundColor: 'rgba(0, 123, 255, 0.2)',
                borderWidth: 2,
                fill: true,
                tension: 0.3,
                pointRadius: 5,
                pointBackgroundColor: 'red'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true
                }
            },
            scales: {
                x: {
                    title: {
                        display: true,
                        text: 'Date'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Sales ($)'
                    },
                    beginAtZero: true
                }
            }
        }
    });
</script>